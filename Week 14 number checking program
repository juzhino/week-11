numbers = []
n = int(input("How many numbers in the list? "))

for i in range(n):
    num = int(input("Enter a number: "))
    numbers.append(num)

search = int(input("Enter the number to find: "))

found = False

for i in range(len(numbers)):
    if numbers[i] == search:
        print("Index:", i)
        found = True
        break

if not found:
    print("Number not in list")
